# NOTE:
# This file is kept for source-of-truth/reference in this repository.
# In production (Cloudflare Workers + OpenNext), security headers are managed via Cloudflare dashboard rules.

/_next/static/*
  Cache-Control: public,max-age=31536000,immutable

/*
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; connect-src 'self' https://cloudflareinsights.com; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
