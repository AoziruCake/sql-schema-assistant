{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sql-schema-assistant",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "NODE_VERSION": "20",
    "NEXT_ON_PAGES_ALLOW_WASM": "true"
  }
}

